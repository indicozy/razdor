+// Razdor's Windows 7 build (a local patch, not upstream): CoTaskMemFree is looked up in ole32.dll when
+// it is used. windows-sys imports it from combase.dll, which Windows 7 does not have (Windows 8 and
+// later), and a link-time name would resolve to that import.
+#[link(name = "kernel32")]
+extern "system" {
+    fn LoadLibraryA(name: *const std::ffi::c_char) -> *mut std::ffi::c_void;
+    fn GetProcAddress(module: *mut std::ffi::c_void, name: *const std::ffi::c_char) -> *mut std::ffi::c_void;
+}
+
+unsafe fn co_task_mem_free(pv: *const std::ffi::c_void) {
+    type Free = unsafe extern "system" fn(*const std::ffi::c_void);
+    static FREE: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
+    let addr = *FREE.get_or_init(|| {
+        let module = LoadLibraryA(b"ole32.dll\0".as_ptr() as *const std::ffi::c_char);
+        if module.is_null() {
+            return None;
+        }
+        let proc = GetProcAddress(module, b"CoTaskMemFree\0".as_ptr() as *const std::ffi::c_char);
+        (!proc.is_null()).then_some(proc as usize)
+    });
+    if let Some(addr) = addr {
+        let free: Free = std::mem::transmute(addr);
+        free(pv);
+    }
+}
