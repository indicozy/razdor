 // IME Association flags
 const IACE_CHILDREN: DWORD = 0x0001;
 
+// Razdor's Windows 7 build (x86_64-win7-windows-gnu): the Windows 8 and 8.1 functions below are looked
+// up when they are used instead of linked, so the program starts on Windows 7; each falls back to
+// what Windows 7 has. Not in miniquad upstream.
+
+// The window's IME context while IME is off on Windows 7 (ImmAssociateContextEx is not there).
+static IME_KEPT_CONTEXT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// `ImmAssociateContextEx` (Windows 8 and later). On Windows 7 the same switch through
+/// `ImmAssociateContext`: flags 0 takes the window's context away and keeps it, IACE_DEFAULT gives it
+/// back, IACE_CHILDREN only takes it away (the helper window).
+unsafe fn imm_associate_context_ex(hwnd: HWND, himc: HIMC, flags: DWORD) -> i32 {
+    type Fun = unsafe extern "system" fn(HWND, HIMC, DWORD) -> i32;
+    static FUN: std::sync::OnceLock<Option<Fun>> = std::sync::OnceLock::new();
+    let fun = *FUN.get_or_init(|| {
+        let module = LoadLibraryA(b"imm32.dll\0".as_ptr() as *const i8);
+        if module.is_null() {
+            return None;
+        }
+        let proc = GetProcAddress(module, b"ImmAssociateContextEx\0".as_ptr() as *const i8);
+        if proc.is_null() {
+            None
+        } else {
+            Some(std::mem::transmute::<_, Fun>(proc))
+        }
+    });
+    match fun {
+        Some(fun) => fun(hwnd, himc, flags),
+        None if flags & IACE_CHILDREN != 0 => {
+            ImmAssociateContext(hwnd, std::ptr::null_mut());
+            1
+        }
+        None if flags & IACE_DEFAULT != 0 => {
+            let kept = IME_KEPT_CONTEXT.swap(0, std::sync::atomic::Ordering::Relaxed) as HIMC;
+            if !kept.is_null() {
+                ImmAssociateContext(hwnd, kept);
+            }
+            1
+        }
+        None => {
+            let prev = ImmAssociateContext(hwnd, std::ptr::null_mut());
+            if !prev.is_null() {
+                IME_KEPT_CONTEXT.store(prev as usize, std::sync::atomic::Ordering::Relaxed);
+            }
+            1
+        }
+    }
+}
+
+/// `GetDpiForMonitor` (Windows 8.1 and later). On Windows 7 the system's DPI, the same on every
+/// monitor there (LOGPIXELSX and LOGPIXELSY of the screen).
+unsafe fn get_dpi_for_monitor(monitor: HMONITOR, dpi_type: MONITOR_DPI_TYPE, x: *mut UINT, y: *mut UINT) -> i32 {
+    type Fun = unsafe extern "system" fn(HMONITOR, MONITOR_DPI_TYPE, *mut UINT, *mut UINT) -> i32;
+    static FUN: std::sync::OnceLock<Option<Fun>> = std::sync::OnceLock::new();
+    let fun = *FUN.get_or_init(|| {
+        let module = LoadLibraryA(b"shcore.dll\0".as_ptr() as *const i8);
+        if module.is_null() {
+            return None;
+        }
+        let proc = GetProcAddress(module, b"GetDpiForMonitor\0".as_ptr() as *const i8);
+        if proc.is_null() {
+            None
+        } else {
+            Some(std::mem::transmute::<_, Fun>(proc))
+        }
+    });
+    match fun {
+        Some(fun) => fun(monitor, dpi_type, x, y),
+        None => {
+            let dc = GetDC(std::ptr::null_mut());
+            *x = GetDeviceCaps(dc, LOGPIXELSX) as UINT;
+            *y = GetDeviceCaps(dc, LOGPIXELSY) as UINT;
+            ReleaseDC(std::ptr::null_mut(), dc);
+            0
+        }
+    }
+}
