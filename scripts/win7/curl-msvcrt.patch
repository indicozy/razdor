 #include "curlx/win32-fopen.h"
 
+/* Razdor's Windows 7 build (a local patch to curl 8.23.0, scripts/win7/curl-msvcrt.patch): the C11
+ * "_s" functions used below are not exported by every msvcrt.dll (Windows 7's is one of them), so
+ * these classic msvcrt functions stand in, with the same results and error codes. */
+#ifdef _WIN32
+#include <errno.h>
+static __inline errno_t razdor_mbstowcs_s(size_t *ret, wchar_t *dst, size_t dstsz,
+                                          const char *src, size_t len)
+{
+  size_t n;
+  if(!dst) {
+    n = mbstowcs(NULL, src, 0);
+    if(n == (size_t)-1)
+      return EILSEQ;
+    if(ret)
+      *ret = n + 1;
+    return 0;
+  }
+  if(!dstsz)
+    return EINVAL;
+  if(len >= dstsz)
+    len = dstsz - 1;
+  n = mbstowcs(dst, src, len);
+  if(n == (size_t)-1)
+    return EILSEQ;
+  dst[n] = 0;
+  if(ret)
+    *ret = n + 1;
+  return 0;
+}
+
+static __inline errno_t razdor_wcstombs_s(size_t *ret, char *dst, size_t dstsz,
+                                          const wchar_t *src, size_t len)
+{
+  size_t n;
+  if(!dst) {
+    n = wcstombs(NULL, src, 0);
+    if(n == (size_t)-1)
+      return EILSEQ;
+    if(ret)
+      *ret = n + 1;
+    return 0;
+  }
+  if(!dstsz)
+    return EINVAL;
+  if(len >= dstsz)
+    len = dstsz - 1;
+  n = wcstombs(dst, src, len);
+  if(n == (size_t)-1)
+    return EILSEQ;
+  dst[n] = 0;
+  if(ret)
+    *ret = n + 1;
+  return 0;
+}
+
+static __inline errno_t razdor_wcsncpy_s(wchar_t *dst, size_t dstsz, const wchar_t *src,
+                                         size_t count)
+{
+  size_t n = 0;
+  if(!dst || !dstsz)
+    return EINVAL;
+  while(n < count && src[n])
+    n++;
+  if(n >= dstsz)
+    return ERANGE;
+  memcpy(dst, src, n * sizeof(wchar_t));
+  dst[n] = 0;
+  return 0;
+}
+
+static __inline errno_t razdor_wcscpy_s(wchar_t *dst, size_t dstsz, const wchar_t *src)
+{
+  size_t n;
+  if(!dst || !dstsz)
+    return EINVAL;
+  n = wcslen(src);
+  if(n >= dstsz)
+    return ERANGE;
+  memcpy(dst, src, (n + 1) * sizeof(wchar_t));
+  return 0;
+}
+
+static __inline errno_t razdor_freopen_s(FILE **file, const char *filename, const char *mode,
+                                         FILE *stream)
+{
+  *file = freopen(filename, mode, stream);
+  return *file ? 0 : errno;
+}
+
+static __inline errno_t razdor_wfreopen_s(FILE **file, const wchar_t *filename,
+                                          const wchar_t *mode, FILE *stream)
+{
+  *file = _wfreopen(filename, mode, stream);
+  return *file ? 0 : errno;
+}
