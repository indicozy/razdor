# The curl.exe that ships beside Razdor.exe in the Windows 7 package (scripts/dist-win7.sh; the fetch is
# scripts/fetch-curl-win.sh). The official static build of curl for Windows (curl.se/windows, the
# win64-mingw zip: bin/curl.exe and COPYING.txt, the license). The one place its address and pin live.
# Version 8.23.0_9 (curl 8.23.0, curl-for-win build 9): the newest official x86_64 build. Its page lists
# Windows Vista to 11, but its curl.exe imports the Universal C Runtime (api-ms-win-crt-*): Windows 7
# runs it only with the UCRT update (KB2999226). The arm64 build of the same release is not used.
CURL_WIN_URL="https://curl.se/windows/dl-8.23.0_9/curl-8.23.0_9-win64-mingw.zip"
CURL_WIN_SIZE=8665536
