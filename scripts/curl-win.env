# The pins of Razdor's Windows 7 curl.exe, built from source by scripts/win7/build-curl.sh (run by
# scripts/dist-win7.sh and the release workflow's windows7 job). One place: versions, the URLs and
# the SHA-256s of the sources. Nothing built is committed.
#
# curl: the release tarball of curl.se (the one the official Windows builds are made from).
CURL_VERSION=8.23.0
CURL_SRC_URL=https://curl.se/download/curl-8.23.0.tar.xz
CURL_SRC_SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5
# mbedTLS 3.6 (the LTS line; Apache-2.0): the TLS library of curl.exe, static.
MBEDTLS_VERSION=3.6.7
MBEDTLS_SRC_URL=https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2
MBEDTLS_SRC_SHA256=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6
# The Mozilla CA bundle of curl.se (MPL-2.0), shipped as curl-ca-bundle.crt beside curl.exe.
# Certificate data as of 2026-11-05.
CACERT_URL=https://curl.se/ca/cacert.pem
CACERT_SHA256=427c064216761a1e72a8b30f0d954d08cb6e4435a82091fb865afd20c8497285
