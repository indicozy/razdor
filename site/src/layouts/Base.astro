---
import "../styles/tokens.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThornyPopup from "../components/ThornyPopup.astro";
import { strings, type Lang } from "../i18n";
import { latest } from "../lib/changelog";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page path without the language or the base, e.g. "/" or "/download/". */
  path: string;
  /** Adds the RSS link of the changes page. */
  rss?: boolean;
  /** A page that only moves: the meta refresh goes to this path (of the same language). */
  redirect?: string;
}
const { lang, title, description, path, rss = false, redirect } = Astro.props;
const S = strings(lang);
const R = S.retro;
const site = "https://razdor.indicozy.dev";
const ruUrl = site + path;
const enUrl = site + "/en" + path;
const canonical = lang === "ru" ? ruUrl : enUrl;
const B = import.meta.env.BASE_URL;
const releases = "https://github.com/indicozy/razdor/releases/latest";
const version = latest()?.version ?? "";
const altTitle = lang === "ru" ? "Времена раздора" : "Discord Times";
const redirectTo = redirect !== undefined ? (lang === "en" ? `${B}en/${redirect}` : `${B}${redirect}`) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={ruUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ruUrl} />
    {rss && <link rel="alternate" type="application/rss+xml" title="Razdor: изменения" href={`${site}/changes/rss.xml`} />}
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <link rel="icon" href={`${B}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${B}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${B}icon-192.png`} />
    <link rel="apple-touch-icon" href={`${B}apple-touch-icon.png`} />
    <meta name="theme-color" content="#0d1f19" />
  </head>
  <body style={`--marble: url('${B}art/marble.webp'); --swords: url('${B}art/swords.webp')`}>
    <a class="skip" href="#main">{S.common.skip}</a>
    <header class="title-band">
      <button type="button" class="music-btn" id="music-btn" aria-pressed="false" data-on={R.musicOff} data-off={R.musicOn}>{R.musicOn}</button>
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={`${B}art/title-still.webp`} />
        <img class="title-img" src={`${B}art/title-burning.webp`} alt={altTitle} width="720" height="180" fetchpriority="high" />
      </picture>
      <audio id="menu-theme" src={`${B}art/menu-theme.ogg`} loop preload="none"></audio>
    </header>
    <Header lang={lang} path={path} />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer lang={lang} />
    <ThornyPopup lang={lang} />
    <script define:vars={{ releases }}>
      // Download buttons: the link goes to the latest release; the caption shows the visitor's platform
      // and its file size (JS only; without it the buttons link to the download page).
      const ua = navigator.userAgent;
      const isIOS = /iPhone|iPad|iPod/.test(ua);
      const isAndroid = /Android/.test(ua);
      const isMac = /Macintosh/.test(ua) && !isIOS;
      const isWin = /Windows/.test(ua);
      const key = isWin ? "windows" : isMac ? "mac" : isAndroid ? "android" : isIOS ? "ios" : "linux";
      document.querySelectorAll("[data-dl-meta]").forEach((p) => {
        const line = JSON.parse(p.dataset.dlMeta || "{}")[key];
        if (line) p.textContent = line;
      });
      document.querySelectorAll("[data-dl]").forEach((a) => {
        a.href = releases;
      });
    </script>
    <script>
      // «♪ Музыка»: the menu theme loops at half volume while on. Never autoplays.
      const audio = document.getElementById("menu-theme") as HTMLAudioElement | null;
      if (audio) {
        audio.volume = 0.5;
        const toggle = () => {
          const playing = !audio.paused;
          if (playing) {
            audio.pause();
          } else {
            audio.play().catch(() => {});
          }
          return !playing;
        };
        const btn = document.getElementById("music-btn");
        btn?.addEventListener("click", () => {
          const on = toggle();
          btn.setAttribute("aria-pressed", String(on));
          btn.textContent = on ? btn.dataset.on || "" : btn.dataset.off || "";
        });
        document.querySelectorAll<HTMLButtonElement>("[data-music-toggle]").forEach((b) => {
          b.addEventListener("click", () => b.setAttribute("aria-pressed", String(toggle())));
        });
      }
    </script>
  </body>
</html>
