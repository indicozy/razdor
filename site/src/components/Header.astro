---
interface Props {
  lang: "ru" | "en";
  path: string;
}
const { lang, path } = Astro.props;
const B = import.meta.env.BASE_URL;
// The same page in the other language: "/" -> "en/", "/download/" -> "en/download/".
const rel = path.replace(/^\//, "");
const switchHref = lang === "ru" ? `${B}en/${rel}` : `${B}${rel}`;
const switchLabel = lang === "ru" ? "EN" : "RU";
const nav = [
  { href: "download/", label: "Скачать" },
  { href: "features/", label: "Возможности" },
  { href: "community/", label: "Сообщество" },
  { href: "changes/", label: "Изменения" },
  { href: "faq/", label: "Вопросы" },
  { href: "wiki/", label: "Вики" },
];
---
<header class="site-header">
  <a class="brand" href={B}>Razdor</a>
  <nav class="nav" aria-label="Основное">
    {nav.map((n) => <a href={`${B}${n.href}`}>{n.label}</a>)}
  </nav>
  <span class="header-spacer"></span>
  <a class="lang-link" href={switchHref} hreflang={lang === "ru" ? "en" : "ru"} lang={lang === "ru" ? "en" : "ru"}>{switchLabel}</a>
  <a class="btn sm" href={`${B}download/`} style="white-space:nowrap">Скачать</a>
  <details class="menu">
    <summary aria-label="Меню">☰</summary>
    <nav class="menu-panel" aria-label="Меню сайта">
      {nav.map((n) => <a href={`${B}${n.href}`}>{n.label}</a>)}
    </nav>
  </details>
</header>
