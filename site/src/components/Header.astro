---
import { strings, href, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const S = strings(lang);
const other = lang === "ru" ? "en" : "ru";
const switchHref = lang === "ru" ? `${import.meta.env.BASE_URL}en/` : `${import.meta.env.BASE_URL}`;
// The menu of the official site: small gold links split by bars. The current page is marked.
const here = (p: string) => (p === "/" ? "/" : p) === path || (p !== "/" && path.startsWith(p));
const nav = [
  { href: "", label: S.nav.home, on: path === "/" },
  { href: "download/", label: S.nav.download, on: here("/download/") },
  { href: "screenshots/", label: S.nav.shots, on: here("/screenshots/") },
  { href: "community/", label: S.nav.community, on: here("/community/") },
  { href: "changes/", label: S.nav.changes, on: here("/changes/") },
  { href: "faq/", label: S.nav.faq, on: here("/faq/") },
];
---
<nav class="menubar" aria-label={S.common.mainNav}>
  <ul>
    {nav.map((n) => (
      <li><a href={href(lang, n.href)} class:list={[{ on: n.on }]} aria-current={n.on ? "page" : undefined}>{n.label}</a></li>
    ))}
    <li><a href="https://discord.gg/wmMksmWFDM" target="_blank" rel="noopener">{S.nav.forum}</a></li>
    <li><a href={href(lang, "wiki/")}>{S.nav.wiki}</a></li>
    <li><a class="lang-link" href={switchHref} hreflang={other} lang={other} data-set-lang={other} aria-label={S.header.langLabel}>{S.header.langLink}</a></li>
  </ul>
</nav>
<script is:inline>
  // The language link remembers the choice (cookie lang) for the bare / redirect; the link works without JS.
  document.addEventListener("click", function (event) {
    var link = event.target.closest && event.target.closest(".lang-link");
    if (!link) return;
    try { document.cookie = "lang=" + link.getAttribute("data-set-lang") + "; Path=/; Max-Age=31536000; SameSite=Lax"; } catch (e) {}
  });
</script>
