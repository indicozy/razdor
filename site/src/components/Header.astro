---
import { strings, href, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const S = strings(lang);
const B = import.meta.env.BASE_URL;
// The same page in the other language: "/" -> "en/", "/download/" -> "en/download/".
const rel = path.replace(/^\//, "");
const switchHref = lang === "ru" ? `${B}en/${rel}` : `${B}${rel}`;
const nav = [
  { href: "download/", label: S.nav.download },
  { href: "features/", label: S.nav.features },
  { href: "community/", label: S.nav.community },
  { href: "changes/", label: S.nav.changes },
  { href: "faq/", label: S.nav.faq },
  { href: "wiki/", label: S.nav.wiki },
];
const other = lang === "ru" ? "en" : "ru";
---
<header class="site-header">
  <a class="brand" href={href(lang, "")}>Razdor</a>
  <nav class="nav" aria-label={S.common.mainNav}>
    {nav.map((n) => <a href={href(lang, n.href)}>{n.label}</a>)}
  </nav>
  <span class="header-spacer"></span>
  <a class="lang-link" href={switchHref} hreflang={other} lang={other} data-set-lang={other} aria-label={S.header.langLabel}>{S.header.langLink}</a>
  <a class="btn sm" href={href(lang, "download/")} style="white-space:nowrap">{S.common.download}</a>
  <details class="menu">
    <summary aria-label={S.common.menu}>☰</summary>
    <nav class="menu-panel" aria-label={S.common.menuLabel}>
      {nav.map((n) => <a href={href(lang, n.href)}>{n.label}</a>)}
    </nav>
  </details>
</header>
<script is:inline>
  // The language link remembers the choice (cookie lang) for the bare / redirect; the link works without JS.
  document.addEventListener("click", function (event) {
    var link = event.target.closest && event.target.closest(".lang-link");
    if (!link) return;
    try { document.cookie = "lang=" + link.getAttribute("data-set-lang") + "; Path=/; Max-Age=31536000; SameSite=Lax"; } catch (e) {}
  });
</script>
