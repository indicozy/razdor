---
import { latest } from "../lib/changelog";
import { strings, href, type Lang } from "../i18n";
import { fill } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const L = S.landing;
const B = import.meta.env.BASE_URL;
const version = latest()?.version ?? "";
// The award badges of the old web: the site's own 88x31 pictures (public/retro) and the game's (/art, outside git).
const badges = [
  { src: `${B}retro/razdor-88x31.gif`, alt: "Razdor", href: href(lang, "") },
  { src: `${B}art/thorny-88x31.png`, alt: "Thorny Times", href: "https://store.steampowered.com/app/2182610/" },
  { src: `${B}retro/discord-88x31.gif`, alt: S.common.discord, href: "https://discord.gg/wmMksmWFDM" },
  { src: `${B}retro/notepad-88x31.gif`, alt: S.common.download, href: href(lang, "download/") },
  { src: `${B}retro/browsers-88x31.gif`, alt: S.common.wiki, href: href(lang, "wiki/") },
];
const otherHref = lang === "ru" ? `${B}en/` : `${B}`;
const other = lang === "ru" ? "en" : "ru";
---
<footer class="site-footer">
  <nav class="footer-links" aria-label={S.common.footerNav}>
    <a href="https://github.com/indicozy/razdor">{S.common.github}</a> ·
    <a href={href(lang, "wiki/")}>{S.common.wiki}</a> ·
    <a href="https://discord.gg/wmMksmWFDM">{S.common.discord}</a> ·
    <a href={href(lang, "wiki/license/")}>{S.footer.license}</a> ·
    <a href={otherHref} lang={other} hreflang={other}>{S.footer.english}</a>
  </nav>
  <ul class="badges" aria-label={S.common.badges}>
    {badges.map((b) => (
      <li><a href={b.href} target={b.href.startsWith("http") ? "_blank" : undefined} rel={b.href.startsWith("http") ? "noopener" : undefined}><img src={b.src} alt={b.alt} width="88" height="31" loading="lazy" /></a></li>
    ))}
  </ul>
  <p class="small-print">{fill(L.footerSmall, { version })}</p>
  <p class="small-print">{L.footerSpirit}</p>
</footer>
