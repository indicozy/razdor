---
import { versions, versionId } from "../../lib/changelog";
import { strings, type Lang } from "../../i18n";
import { longDate } from "../../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const K = S.changes;
const all = versions();
const B = import.meta.env.BASE_URL;
const groups = ["added", "changed", "fixed"] as const;
---
<div class="changes-layout">
  <aside class="vnav" aria-label={K.versions}>
    <p class="vnav-title">{K.versions}</p>
    <ul class="vlist-items">
      {all.map((r) => (
        <li><a href={`#${versionId(r.version)}`}>{r.version}</a></li>
      ))}
    </ul>
  </aside>
  <div class="changes-main">
    <h1>{K.h1}</h1>
    <p class="lead">{K.intro}</p>
    {lang === "en" && <p class="small">{K.enNote}</p>}
    <details class="vdetails">
      <summary>{K.versions}</summary>
      <ul class="vlist-items">
        {all.map((r) => (
          <li><a href={`#${versionId(r.version)}`}>{r.version}</a></li>
        ))}
      </ul>
    </details>
    <p class="small"><a class="link" href={`${B}changes/rss.xml`}>{K.rss}</a></p>
    {all.map((r) => (
      <section class="release" id={versionId(r.version)} aria-labelledby={`${versionId(r.version)}-h`}>
        <h2 id={`${versionId(r.version)}-h`}>{r.version}</h2>
        <p class="news-date">{longDate(lang, r.date)}</p>
        {groups.map((g) =>
          r[g].length > 0 && (
            <>
              <h3>{K.groups[g]}</h3>
              <ul class="release-lines">
                {r[g].map((line) => <li>{line}</li>)}
              </ul>
            </>
          ),
        )}
        {r.sha256.length > 0 && (
          <details class="sha-block">
            <summary>{K.sha}</summary>
            <pre class="sha-pre"><code>{r.sha256.map((s) => `${s.hash}  ${s.file}`).join("\n")}</code></pre>
          </details>
        )}
      </section>
    ))}
  </div>
</div>
