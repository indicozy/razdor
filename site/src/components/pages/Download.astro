---
import { latest, shaOf } from "../../lib/changelog";
import { strings, href, type Lang } from "../../i18n";
import { RELEASES, MIRROR } from "../../lib/format";
import { assetSizes, formatSize } from "../../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const D = S.download;
const rel = latest();
const v = rel?.version ?? "";
const wiki = (p: string) => href(lang, "wiki/" + p);
// The file sizes of the latest release (null when the GitHub API could not be read: no size then).
const sizes = await assetSizes();

// One row per system. The file name is the release asset's exact name.
const rows = [
  { key: "windows", file: "Razdor.exe", info: D.windows },
  { key: "windows7", file: `razdor-${v}-windows7.zip`, info: D.windows7 },
  { key: "linux", file: "razdor", info: D.linux },
  { key: "macos", file: "razdor-macos", info: D.macos },
  { key: "android", file: "razdor.apk", info: D.android },
  { key: "ios", file: "razdor.ipa", info: D.ios },
].map((c) => {
  const bytes = sizes?.get(c.file);
  return {
    ...c,
    sha: rel ? shaOf(rel, c.file) : null,
    size: bytes ? formatSize(bytes, lang) : "",
    source: RELEASES + c.file,
    mirror: MIRROR + c.file,
  };
});
---
<section class="sec first content" aria-labelledby="dl-title">
  <h1 id="dl-title">{D.h1}</h1>
  <p class="lead">{D.intro}</p>

  <div class="dl-rows" id="cards">
    {rows.map((c) => (
      <article class="dl-row" id={c.key} data-key={c.key}>
        <h3 class="dl-name">{c.info.title}</h3>
        <p class="small muted">{c.info.note}</p>
        <p class="dl-file">{[c.file, c.file.includes(v) ? "" : v, c.size].filter(Boolean).join(", ")}</p>
        <code class="dl-sha">{c.sha ? `SHA-256 ${c.sha}` : D.shaMissing}</code>
        <div class="row">
          <a class="btn" href={c.source}>{S.common.download}</a>
          <a class="link" href={c.mirror}>{D.cardMirror}</a>
        </div>
      </article>
    ))}
  </div>

  <section class="dl-section" id="install" aria-labelledby="install-title">
    <h2 id="install-title">{D.installTitle}</h2>
    <ol class="dl-steps">
      {D.installSteps.map((s) => <li>{s}</li>)}
    </ol>
    <h3>{D.noGameTitle}</h3>
    <p>{D.noGameText}</p>
    <p class="small">{D.iosGame}</p>
    <p><a class="link" href={wiki("start/install-razdor/")}>{D.installWiki}</a></p>
  </section>

  <section class="dl-section" aria-labelledby="logs-title">
    <h2 id="logs-title">{D.logsTitle}</h2>
    <ul>
      <li><code>{D.logWin}</code></li>
      <li><code>{D.logLinux}</code></li>
      <li><code>{D.logMac}</code></li>
    </ul>
    <p class="small">{D.logsText}</p>
  </section>

  <section class="dl-section" aria-labelledby="other-title">
    <h2 id="other-title">{D.otherTitle}</h2>
    <p>{D.otherText}</p>
  </section>

  <section class="dl-section" aria-labelledby="older-title">
    <h2 id="older-title">{D.olderTitle}</h2>
    <p>{D.olderText}</p>
    <a class="link" href="https://github.com/indicozy/razdor/releases">{D.olderLink}</a>
  </section>
</section>

<script>
  // Moves the visitor's system to the top and makes its row larger. Without JS the list stays in its order.
  const ua = navigator.userAgent;
  let key = null;
  if (/iPhone|iPad|iPod/.test(ua)) key = "ios";
  else if (/Android/.test(ua)) key = "android";
  else if (/Macintosh/.test(ua)) key = "macos";
  else if (/Windows/.test(ua)) key = "windows";
  else if (/Linux|X11/.test(ua)) key = "linux";
  const row = key ? document.querySelector(`.dl-row[data-key="${key}"]`) : null;
  if (row) row.classList.add("is-main");
</script>
