---
import { latest, shaOf } from "../../lib/changelog";
import { strings, href, type Lang } from "../../i18n";
import { fill } from "../../lib/i18n";
import { RELEASES, MIRROR } from "../../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const D = S.download;
const rel = latest();
const v = rel?.version ?? "";
const wiki = (p: string) => href(lang, "wiki/" + p);

// One card per system. The file name is the release asset's exact name.
const cards = [
  { key: "windows", file: "Razdor.exe", info: D.windows },
  { key: "windows7", file: `razdor-${v}-windows7.zip`, info: D.windows7 },
  { key: "linux", file: "razdor", info: D.linux },
  { key: "macos", file: "razdor-macos", info: D.macos },
  { key: "android", file: "razdor.apk", info: D.android },
  { key: "ios", file: "razdor.ipa", info: D.ios },
].map((c) => ({
  ...c,
  sha: rel ? shaOf(rel, c.file) : null,
  source: RELEASES + c.file,
  mirror: MIRROR + c.file,
}));
const platformNames: Record<string, string> = { windows: "Windows", macos: "macOS", linux: "Linux", android: "Android", ios: "iOS" };
// The detected-platform card: the script fills it from the visitor's browser (JS only).
const detect = Object.fromEntries(
  ["windows", "macos", "linux", "android", "ios"].map((k) => {
    const c = cards.find((x) => x.key === k)!;
    return [k, { name: platformNames[k], url: c.source }];
  }),
);
const labelTemplate = S.download.detectLink;
---
<section class="sec first content" aria-labelledby="dl-title">
  <h1 id="dl-title">{D.h1}</h1>
  <p class="lead">{D.intro}</p>

  <section class="panel detect" aria-labelledby="detect-title">
    <div class="titlebar" id="detect-title">{D.detectTitle}</div>
    <p class="small" id="detect-text">{rel ? `Razdor ${v}` : ""}</p>
    <div class="row">
      <a class="btn" id="detect-link" href="#cards">{S.common.download}</a>
    </div>
  </section>

  <div class="dl-cards" id="cards">
    {cards.map((c) => (
      <article class="panel dl-card" id={c.key}>
        <div class="titlebar">{c.info.title}</div>
        <p>{c.info.note}</p>
        <dl class="dl-facts">
          <dt>{D.cardFile}</dt>
          <dd><code>{c.file}</code></dd>
          <dt>{D.cardVersion}</dt>
          <dd>{v}</dd>
          <dt>{D.cardSha}</dt>
          <dd><code class="sha">{c.sha ?? D.shaMissing}</code></dd>
        </dl>
        <div class="row">
          <a class="btn sm" href={c.source}>{D.cardSource}</a>
          <a class="link" href={c.mirror}>{D.cardMirror}</a>
        </div>
      </article>
    ))}
  </div>

  <section class="dl-section" id="install" aria-labelledby="install-title">
    <h2 id="install-title">{D.installTitle}</h2>
    <ol class="dl-steps">
      {D.installSteps.map((s) => <li>{s}</li>)}
    </ol>
    <h3>{D.noGameTitle}</h3>
    <p>{D.noGameText}</p>
    <p class="small">{D.iosGame}</p>
    <p><a class="link" href={wiki("start/install-razdor/")}>{D.installWiki} →</a></p>
  </section>

  <section class="dl-section" aria-labelledby="logs-title">
    <h2 id="logs-title">{D.logsTitle}</h2>
    <ul>
      <li><code>{D.logWin}</code></li>
      <li><code>{D.logLinux}</code></li>
      <li><code>{D.logMac}</code></li>
    </ul>
    <p class="small">{D.logsText}</p>
  </section>

  <section class="dl-section" aria-labelledby="other-title">
    <h2 id="other-title">{D.otherTitle}</h2>
    <p>{D.otherText}</p>
  </section>

  <section class="dl-section" aria-labelledby="older-title">
    <h2 id="older-title">{D.olderTitle}</h2>
    <p>{D.olderText}</p>
    <a class="link" href="https://github.com/indicozy/razdor/releases">{D.olderLink} →</a>
  </section>
</section>

<script define:vars={{ detect, labelTemplate }}>
  // Fills the detected-platform card from the visitor's browser. Without JS it keeps the list below.
  const ua = navigator.userAgent;
  let key = null;
  if (/iPhone|iPad|iPod/.test(ua)) key = "ios";
  else if (/Android/.test(ua)) key = "android";
  else if (/Macintosh/.test(ua)) key = "macos";
  else if (/Windows/.test(ua)) key = "windows";
  else if (/Linux|X11/.test(ua)) key = "linux";
  if (key) {
    const d = detect[key];
    const link = document.getElementById("detect-link");
    const text = document.getElementById("detect-text");
    if (link && d) {
      link.textContent = labelTemplate.replace("{platform}", d.name);
      link.href = d.url;
    }
    if (text && d) text.textContent = d.name + ": " + d.url.split("/").pop();
  }
</script>
