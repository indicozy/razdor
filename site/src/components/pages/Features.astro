---
import { strings, href, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const F = S.features;
const B = import.meta.env.BASE_URL;
const shots = ["game", "devices", "extras", "langs"];
---
<section class="sec first content" aria-labelledby="features-title">
  <h1 id="features-title">{F.h1}</h1>
  <p class="lead">{F.intro}</p>
  {F.blocks.map((b, i) => (
    <section class={i % 2 ? "feature alt" : "feature"} aria-labelledby={`feature-${i}`}>
      <div class="pic" role="img" aria-label={b.alt} style={`background-image:url('${B}art/shot-${shots[i]}.webp')`}></div>
      <div>
        <h2 id={`feature-${i}`}>{b.title}</h2>
        <ul class="feature-lines">
          {b.lines.map((l) => <li>{l}</li>)}
        </ul>
        <a class="link" href={href(lang, b.href)}>{b.link}</a>
      </div>
    </section>
  ))}
</section>
