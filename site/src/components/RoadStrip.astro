---
// The road: a fixed strip on the right of wide screens (the hero walks it as the page scrolls),
// a faded background below 1300 px. Stops line up with the sections that carry data-stop.
const stops = [
  "Замок отца",
  "Трактир «Чёрная борода»",
  "Столица",
  "Перекрёсток",
  "Королевская долина",
  "Дворец",
];
const B = import.meta.env.BASE_URL;
const frames = 21; // torch strip: 21 frames of 64 px (art/s-fire.webp, S-Fire frames 20-40)
---
<div class="road" data-at="0" data-walking="false" aria-hidden="true">
  <div class="road-ground"></div>
  <svg class="road-svg" viewBox="0 0 300 1000" preserveAspectRatio="none">
    <path class="road-edge" d="M150 0 C150 120 110 220 150 330 C190 440 120 560 150 680 C175 780 140 880 150 1000" />
    <path class="road-path" d="M150 0 C150 120 110 220 150 330 C190 440 120 560 150 680 C175 780 140 880 150 1000" />
    <path class="route" d="M150 0 C150 120 110 220 150 330 C190 440 120 560 150 680 C175 780 140 880 150 1000" />
  </svg>
  <div class="road-fade"></div>
  {stops.map((label, i) => (
    <div class="stop" data-stop-index={i} style={`top:${((i + 0.5) / stops.length * 100).toFixed(2)}%`}>
      <span class="stop-mark">{label}</span>
    </div>
  ))}
  <div class="fire" style={`left:14px; top:calc(${(0.5 / stops.length * 100).toFixed(2)}% - 120px); --frames:${frames}; background-image:url('${B}art/s-fire.webp')`}></div>
  <div class="fire" style={`left:200px; top:calc(${(0.5 / stops.length * 100).toFixed(2)}% - 120px); --frames:${frames}; background-image:url('${B}art/s-fire.webp')`}></div>
  <div class="army-grp" style={`left:14px; top:calc(${(4.5 / stops.length * 100).toFixed(2)}% - 150px); --sheet:url('${B}art/knight-sheet.webp')`}>
    <i class="k" style="left:0; top:0"></i><i class="k" style="left:56px; top:14px"></i>
    <i class="k" style="left:10px; top:50px"></i><i class="k" style="left:64px; top:52px"></i>
  </div>
  <div class="army-grp" style={`left:150px; top:calc(${(4.5 / stops.length * 100).toFixed(2)}% - 150px); --sheet:url('${B}art/necromant-sheet.webp')`}>
    <i class="n" style="left:0; top:0"></i><i class="n" style="left:56px; top:14px"></i>
    <i class="n" style="left:10px; top:50px"></i><i class="n" style="left:64px; top:52px"></i>
  </div>
  <div class="hero" style={`background-image:url('${B}art/hero-knight-walk-s.webp')`}></div>
</div>

<script>
  // Moves the hero to the stop of the section most in view, and marks the road as walking while
  // the page scrolls. Plain IntersectionObserver: works in every browser the site supports.
  const road = document.querySelector<HTMLElement>(".road");
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-stop]"));
  if (road && sections.length) {
    let walkTimer = 0;
    const setStop = (n: number) => {
      road.dataset.at = String(n);
      road.querySelectorAll<HTMLElement>(".stop").forEach((s) => {
        s.dataset.stopActive = String(Number(s.dataset.stopIndex) === n);
      });
    };
    const visible = new Map<HTMLElement, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target as HTMLElement, e.intersectionRatio);
        let best: HTMLElement | null = null;
        let bestRatio = 0;
        for (const [el, r] of visible) if (r > bestRatio) { best = el; bestRatio = r; }
        if (best) setStop(Number(best.dataset.stop));
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => io.observe(s));
    setStop(Number(sections[0].dataset.stop ?? 0));
    window.addEventListener(
      "scroll",
      () => {
        road.dataset.walking = "true";
        clearTimeout(walkTimer);
        walkTimer = window.setTimeout(() => (road.dataset.walking = "false"), 250);
      },
      { passive: true },
    );
  }
</script>
