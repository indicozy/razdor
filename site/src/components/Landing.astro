---
import { latest } from "../lib/changelog";
import { catalog, counts, pictureUrl, type CatalogEntry } from "../lib/catalog";
import { strings, href, hubLine, type Lang } from "../i18n";
import { assetSizes, formatSize } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const L = S.landing;
const B = import.meta.env.BASE_URL;
const rel = latest();
const version = rel?.version ?? "";
const dateText = rel
  ? new Intl.DateTimeFormat(lang === "ru" ? "ru-RU" : "en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
      .format(new Date(rel.date + "T12:00:00Z"))
      .replace(" г.", "")
  : "";
// Russian lines only: the release notes are in Russian, so the English page links to them instead.
const news = lang === "ru" && rel ? [...rel.fixed, ...rel.changed, ...rel.added].slice(0, 3) : [];
// The size line shows the Windows file for the default system; the layout's script swaps it per visitor.
const sizes = await assetSizes();
const sysNames = { windows: "Windows", mac: "macOS", linux: "Linux", android: "Android", ios: "iOS" } as const;
const sysFiles = { windows: "Razdor.exe", mac: "razdor-macos", linux: "razdor", android: "razdor.apk", ios: "razdor.ipa" } as const;
const othersWord = L.meta.split(":")[0];
const metaFor = (k: keyof typeof sysNames) => {
  const size = sizes?.get(sysFiles[k]);
  const others = (Object.keys(sysNames) as (keyof typeof sysNames)[]).filter((o) => o !== k).map((o) => sysNames[o]);
  return [version, size ? formatSize(size, lang) : "", `${othersWord}: ${others.join(", ")}`].filter(Boolean).join(", ");
};
const metaBySystem = Object.fromEntries((Object.keys(sysNames) as (keyof typeof sysNames)[]).map((k) => [k, metaFor(k)]));
// The Hub: the counts line from the community catalog at build time (the generic line without it), and three
// entries as picture tiles. Entries a player would recognise come first: a known author, a real title and a
// picture; mods, then campaigns, then maps. Placeholder authors and file-name titles («Name-Title-01») go last.
const cat = await catalog();
const hub = hubLine(lang, cat ? counts(cat) : null) ?? L.hubFallback;
const known = (e: CatalogEntry) =>
  !!e.author?.trim() &&
  !/^(неизвестен|неизвестно|unknown|-|\?)$/i.test(e.author.trim()) &&
  !/-\d+$/.test((e.title?.ru || e.title?.en || "").trim());
const ranked: CatalogEntry[] = cat
  ? [
      ...(["mod", "campaign", "map"] as const).flatMap((k) =>
        cat.entries.filter((e) => e.kind === k && known(e) && pictureUrl(e)),
      ),
      ...cat.entries.filter(known),
      ...cat.entries,
    ]
  : [];
const picks = [...new Set(ranked)].slice(0, 3);
const pickText = (t?: { ru: string; en: string }) => (lang === "en" && t?.en ? t.en : t?.ru ?? "");
const kindText = (k: string) => (k === "mod" ? L.hubKindMod : L.hubKindMap);
// A title missing in both languages gets the kind's generic word, never the catalog id or a bare hash.
const entryTitle = (e: (typeof picks)[number]) => {
  const t = pickText(e.title);
  return t && t !== e.id && !/^[0-9a-f]{12,}$/i.test(t) ? t : kindText(e.kind);
};
const art = (name: string) => `background-image:url('${B}art/${name}')`;
const steps = [
  { title: L.step1, line: L.step1Line },
  { title: L.step2, line: L.step2Line },
  { title: L.step3, line: L.step3Line },
];
---
<div class="landing">
  <section class="hero" aria-labelledby="hero-title" style={art("a-big.webp")}>
    <div class="content hero-inner">
      <h1 id="hero-title">{L.heroTitle}</h1>
      <p class="lead">{L.lead}</p>
      <div class="row">
        <a class="btn" href={href(lang, "download/")} data-dl>{S.common.download}</a>
        <a class="btn ghost" href="https://www.youtube.com/watch?v=kHvM7Yv-2_4" target="_blank" rel="noopener">{L.trailer}</a>
      </div>
      <p class="small muted" data-dl-meta={JSON.stringify(metaBySystem)}>{metaFor("windows")}</p>
      <p class="small muted">{L.autoGame}</p>
    </div>
  </section>

  <section class="sec content" aria-labelledby="campaign-title">
    <h2 id="campaign-title">{L.campaignTitle}</h2>
    <p class="intro">{L.campaignText}</p>
    <div class="gallery">
      <figure class="gallery-big">
        <div class="pic" role="img" aria-label={L.battleAlt} style={art("b-battle.webp")}></div>
        <figcaption>{L.battleAlt}</figcaption>
      </figure>
      <figure>
        <div class="pic" role="img" aria-label={L.townAlt} style={art("b-town.webp")}></div>
        <figcaption>{L.townAlt}</figcaption>
      </figure>
      <figure>
        <div class="pic" role="img" aria-label={L.battleAlt2} style={art("b-battle-alt.webp")}></div>
        <figcaption>{L.battleAlt2}</figcaption>
      </figure>
    </div>
    <div class="linkrow"><a class="link" href={href(lang, "features/")}>{L.campaignLink}</a></div>
  </section>

  <section class="sec content" aria-labelledby="why-title">
    <h2 id="why-title">{L.whyTitle}</h2>
    <ul class="why-list">
      {L.whyItems.map((it) => (
        <li>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </li>
      ))}
    </ul>
    <div class="linkrow"><a class="link" href={href(lang, "features/")}>{L.whyLink}</a></div>
  </section>

  <section class="sec content" aria-labelledby="install-title">
    <h2 id="install-title">{L.installTitle}</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.line}</p>
        </li>
      ))}
    </ol>
    <div class="row">
      <a class="btn" href={href(lang, "download/")} data-dl>{S.common.download}</a>
      <a class="link" href={href(lang, "download/") + "#install"}>{S.common.detailedInstall}</a>
    </div>
  </section>

  <section class="sec content" aria-labelledby="community-title">
    <h2 id="community-title">{L.communityTitle}</h2>
    <p class="intro">{hub}</p>
    {picks.length > 0 && (
      <ul class="hub-tiles">
        {picks.map((e) => {
          const thumb = pictureUrl(e);
          return (
            <li class="hub-tile">
              {thumb ? (
                <>
                  <img class="pic-img" src={thumb} alt="" width="480" height="270" loading="lazy" decoding="async" />
                  <h3 class="hub-title">{entryTitle(e)}</h3>
                </>
              ) : (
                <div class="hub-nopic"><h3 class="hub-title">{entryTitle(e)}</h3></div>
              )}
              <p class="small">{kindText(e.kind)}, {L.hubAuthor}: {e.author}</p>
            </li>
          );
        })}
      </ul>
    )}
    <div class="row">
      <a class="btn" href="https://discord.gg/wmMksmWFDM">{S.common.discord}</a>
      <a class="btn ghost" href={href(lang, "community/")}>{L.hubAll}</a>
    </div>
  </section>

  <section class="sec content split" aria-labelledby="news-title">
    <div>
      <h2 id="news-title">{L.newsTitle} {version}</h2>
      <p class="news-date">{dateText}</p>
      {news.length > 0 && (
        <ul class="news-list">
          {news.map((line) => <li>{line}</li>)}
        </ul>
      )}
      <a class="link" href={href(lang, "changes/")}>{L.allChanges}</a>
    </div>
    <div class="thorny" id="trailer">
      <div class="pic thorny-pic" role="img" aria-label={L.thornyAlt} style={art("thorny-capsule.webp")}></div>
      <h3 id="thorny-title">{L.thornyTitle}</h3>
      <p>{L.thornyText}</p>
      <a class="btn ghost sm" href="https://store.steampowered.com/app/2182610/" target="_blank" rel="noopener">{L.steam}</a>
    </div>
  </section>
</div>
