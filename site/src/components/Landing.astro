---
import { latest, versions, versionId } from "../lib/changelog";
import { catalog, counts, pictureUrl, titlesById, type CatalogEntry } from "../lib/catalog";
import { strings, href, hubLine, type Lang } from "../i18n";
import { assetSizes, downloadTotal, formatSize } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const L = S.landing;
const R = S.retro;
const B = import.meta.env.BASE_URL;
const rel = latest();
const version = rel?.version ?? "";
// The size line shows the Windows file for the default system; the layout's script swaps it per visitor.
const sizes = await assetSizes();
const sysNames = { windows: "Windows", mac: "macOS", linux: "Linux", android: "Android", ios: "iOS" } as const;
const sysFiles = { windows: "Razdor.exe", mac: "razdor-macos", linux: "razdor", android: "razdor.apk", ios: "razdor.ipa" } as const;
const othersWord = L.meta.split(":")[0];
const metaFor = (k: keyof typeof sysNames) => {
  const size = sizes?.get(sysFiles[k]);
  const others = (Object.keys(sysNames) as (keyof typeof sysNames)[]).filter((o) => o !== k).map((o) => sysNames[o]);
  return [version, size ? formatSize(size, lang) : "", `${othersWord}: ${others.join(", ")}`].filter(Boolean).join(", ");
};
const metaBySystem = Object.fromEntries((Object.keys(sysNames) as (keyof typeof sysNames)[]).map((k) => [k, metaFor(k)]));
// The Hub: the counts line from the community catalog at build time and three entries as picture tiles.
// Entries a player would recognise come first: a known author, a real title and a picture; mods, then
// campaigns, then maps. Placeholder authors and file-name titles («Name-Title-01») go last.
const cat = await catalog();
const hub = hubLine(lang, cat ? counts(cat) : null) ?? L.hubFallback;
// Ids and titles only, for the play-stats tables of the counter (filled by scripts/stats.ts).
const mapNames = titlesById(cat);
const known = (e: CatalogEntry) =>
  !!e.author?.trim() &&
  !/^(неизвестен|неизвестно|unknown|-|\?)$/i.test(e.author.trim()) &&
  !/-\d+$/.test((e.title?.ru || e.title?.en || "").trim());
const ranked: CatalogEntry[] = cat
  ? [
      ...(["mod", "campaign", "map"] as const).flatMap((k) =>
        cat.entries.filter((e) => e.kind === k && known(e) && pictureUrl(e)),
      ),
      ...cat.entries.filter(known),
      ...cat.entries,
    ]
  : [];
const picks = [...new Set(ranked)].slice(0, 3);
const pickText = (t?: { ru: string; en: string }) => (lang === "en" && t?.en ? t.en : t?.ru ?? "");
const kindText = (k: string) => (k === "mod" ? L.hubKindMod : L.hubKindMap);
// A title missing in both languages gets the kind's generic word, never the catalog id or a bare hash.
const entryTitle = (e: (typeof picks)[number]) => {
  const t = pickText(e.title);
  return t && t !== e.id && !/^[0-9a-f]{12,}$/i.test(t) ? t : kindText(e.kind);
};
// The news: the latest five releases, newest first. The notes are in Russian: the English page gives the version and date only.
const DAY = 86400000;
const postDate = (iso: string) => {
  const [y, m, d] = iso.split("-");
  return `${d}.${m}.${y}`;
};
const isNew = (iso: string) => Date.now() - Date.parse(iso + "T12:00:00Z") < 14 * DAY;
const news = versions().slice(0, 5).map((r) => ({
  id: versionId(r.version),
  version: r.version,
  date: postDate(r.date),
  fresh: isNew(r.date),
  lines: lang === "ru" ? [...r.fixed, ...r.changed, ...r.added].slice(0, 2) : [],
}));
// The downloads counter: the total of all releases, or no counter when the API cannot be read.
const total = await downloadTotal();
const counter = total === null ? null : String(total).padStart(7, "0");
const art = (name: string) => `background-image:url('${B}art/${name}')`;
const steps = [
  { title: L.step1, line: L.step1Line },
  { title: L.step2, line: L.step2Line },
  { title: L.step3, line: L.step3Line },
];
const shots = [
  { file: "a-big.webp", alt: R.shotCaps["a-big"] },
  { file: "b-battle.webp", alt: R.shotCaps["b-battle"] },
  { file: "b-town.webp", alt: R.shotCaps["b-town"] },
];
---
<div class="home">
  <div class="home-main">
    <section class="win" aria-labelledby="welcome-title">
      <h2 id="welcome-title">{R.welcome}</h2>
      <div class="win-body">
        <p class="lead">{L.lead}</p>
        <p class="dl-line">
          <a class="btn" href={href(lang, "download/")} data-dl>{S.common.download}</a>
          <span class="small" data-dl-meta={JSON.stringify(metaBySystem)}>{metaFor("windows")}</span>
        </p>
        <p class="small">{L.autoGame}</p>
      </div>
    </section>

    <section class="win" aria-labelledby="trailer-title">
      <h2 id="trailer-title">{R.trailerTitle}</h2>
      <div class="win-body">
        <!-- Click to load: nothing from YouTube loads until the visitor presses play (privacy); without JS the link opens YouTube. -->
        <a class="yt" href="https://www.youtube.com/watch?v=kHvM7Yv-2_4" target="_blank" rel="noopener" data-yt="kHvM7Yv-2_4" aria-label={R.trailerPlay}>
          <img src={`${B}art/a-big.webp`} alt="" loading="lazy" decoding="async" />
          <span class="yt-play" aria-hidden="true">&#9658;</span>
          <span class="yt-cap">{R.trailerPlay}</span>
        </a>
      </div>
    </section>

    <section class="win" aria-labelledby="news-title">
      <h2 id="news-title">{R.news}</h2>
      <div class="win-body">
        {news.map((n) => (
          <article class="post">
            <p class="post-head"><b>{n.date}</b>{n.fresh && <span class="new">{R.newBadge}</span>} {lang === "ru" ? `Вышел Razdor ${n.version}.` : `Razdor ${n.version} is out.`}</p>
            {n.lines.length > 0 && (
              <ul class="post-lines">
                {n.lines.map((line) => <li>{line}</li>)}
              </ul>
            )}
            <a class="link small" href={href(lang, "changes/") + `#${n.id}`}>{R.newsMore}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="win" aria-labelledby="what-title">
      <h2 id="what-title">{R.whatTitle}</h2>
      <div class="win-body">
        <ul class="bullets">
          {L.whyItems.map((it) => (
            <li><b>{it.t}.</b> {it.d}</li>
          ))}
        </ul>
        <p class="small"><a class="link" href={href(lang, "download/") + "#install"}>{S.common.detailedInstall}</a> · <a class="link" href={href(lang, "download/")}>{S.common.download}</a></p>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="step-num" aria-hidden="true">{i + 1}</span> <b>{s.title}.</b> {s.line}</li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <aside class="home-side">
    <section class="win" aria-labelledby="shots-title">
      <h2 id="shots-title">{R.shots}</h2>
      <div class="win-body shot-thumbs">
        {shots.map((s) => (
          <a class="shot-link" href={href(lang, "screenshots/")} aria-label={s.alt}>
            <span class="pic" role="img" aria-label={s.alt} style={art(s.file)}></span>
          </a>
        ))}
        <p class="small"><a class="link" href={href(lang, "screenshots/")}>{R.shotsAll}</a></p>
      </div>
    </section>

    {counter && (
      <section class="win" aria-labelledby="counter-title">
        <h2 id="counter-title">{R.counterTitle}</h2>
        <div class="win-body">
          <p>{R.counter} <span class="counter" aria-label={String(total)}>{counter}</span></p>
          <div class="play-stats" id="play-stats" data-lang={lang} data-wins={R.statsWins} data-original={R.statsOriginal} hidden>
            <table data-board="top-maps" hidden>
              <caption>{R.statsTop}</caption>
              <thead><tr><th>{R.statsMap}</th><th class="n">{R.statsCount}</th></tr></thead>
              <tbody></tbody>
            </table>
            <table data-board="hard-maps" hidden>
              <caption>{R.statsHard}</caption>
              <thead><tr><th>{R.statsMap}</th><th class="n">{R.statsRate}</th></tr></thead>
              <tbody></tbody>
            </table>
            <table data-board="games" hidden>
              <caption>{R.statsGames}</caption>
              <thead><tr><th>{R.statsGame}</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
          <script is:inline type="application/json" id="map-names" set:html={JSON.stringify(mapNames).replace(/</g, "\\u003c")}></script>
        </div>
      </section>
    )}

    <section class="win" aria-labelledby="maps-title">
      <h2 id="maps-title">{R.maps}</h2>
      <div class="win-body">
        <p class="small">{hub}</p>
        {picks.length > 0 && (
          <ul class="hub-tiles">
            {picks.map((e) => {
              const thumb = pictureUrl(e);
              return (
                <li class="hub-tile">
                  {thumb ? <img class="pic-img" src={thumb} alt="" width="480" height="270" loading="lazy" decoding="async" /> : null}
                  <span class="hub-title">{entryTitle(e)}</span>
                  <span class="small">{kindText(e.kind)}, {L.hubAuthor}: {e.author}</span>
                </li>
              );
            })}
          </ul>
        )}
        <p class="small"><a class="link" href={href(lang, "community/")}>{R.mapsAll}</a></p>
      </div>
    </section>

    <section class="win" aria-labelledby="links-title">
      <h2 id="links-title">{R.links}</h2>
      <div class="win-body">
        <ul class="bullets">
          <li><a class="link" href="https://discord.gg/wmMksmWFDM">{R.linkDiscord}</a></li>
          <li><a class="link" href="https://github.com/indicozy/razdor">{R.linkGithub}</a></li>
          <li><a class="link" href={href(lang, "wiki/")}>{R.linkWiki}</a></li>
          <li><a class="link" href="https://store.steampowered.com/app/2182610/" target="_blank" rel="noopener">{R.linkThorny}</a></li>
        </ul>
      </div>
    </section>
  </aside>
</div>

<script>
  import "../scripts/stats.ts";
</script>

<script>
  // The trailer: the YouTube player replaces the poster only after a click (youtube-nocookie, autoplay).
  document.querySelectorAll<HTMLAnchorElement>("a.yt[data-yt]").forEach((a) => {
    a.addEventListener("click", (ev) => {
      ev.preventDefault();
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      f.title = a.getAttribute("aria-label") || "Trailer";
      f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      f.allowFullscreen = true;
      f.className = "yt-frame";
      a.replaceWith(f);
    });
  });
</script>
