---
import { latest } from "../lib/changelog";
import { catalog, counts } from "../lib/catalog";
import { strings, href, hubLine, type Lang } from "../i18n";
import Battle from "./Battle.astro";
import { assetSizes, formatSize } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = strings(lang);
const L = S.landing;
const B = import.meta.env.BASE_URL;
const rel = latest();
const version = rel?.version ?? "";
const dateText = rel
  ? new Intl.DateTimeFormat(lang === "ru" ? "ru-RU" : "en-US", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
      .format(new Date(rel.date + "T12:00:00Z"))
      .replace(" г.", "")
  : "";
// Russian lines only: the release notes are in Russian, so the English page links to them instead.
const news = lang === "ru" && rel ? [...rel.fixed, ...rel.changed, ...rel.added].slice(0, 3) : [];
// The Hub counts come from the community catalog at build time; without it the generic line stays.
// The size line shows the Windows file: the default system of the page.
const sizes = await assetSizes();
const exeSize = sizes?.get("Razdor.exe");
const sizeText = exeSize ? formatSize(exeSize, lang) : "";
const cat = await catalog();
const hub = hubLine(lang, cat ? counts(cat) : null) ?? L.hubFallback;
const art = (name: string) => `background-image:url('${B}art/${name}')`;
const routeD = [
  "M40 14 C160 80, 250 -6, 380 50 S 610 92, 700 34 S 820 50, 880 60",
  "M60 40 C180 4, 260 96, 390 56 S 560 4, 640 60 S 760 90, 880 40",
  "M40 50 C140 10, 220 88, 330 46 S 520 6, 600 52 S 760 92, 860 30",
  "M60 30 C170 80, 240 -4, 370 40 S 590 90, 700 46 S 800 20, 880 56",
];
---
<div class="landing">
  <section class="sec first content" data-stop="0" aria-labelledby="hero-title">
    <h1 id="hero-title">{L.heroTitle}</h1>
    <p class="lead">{L.lead}</p>
    <div class="row">
      <a class="btn" href={href(lang, "download/")} data-dl>{S.common.download}</a>
      <a class="btn ghost" href="https://www.youtube.com/watch?v=kHvM7Yv-2_4" target="_blank" rel="noopener">{L.trailer}</a>
    </div>
    <p class="small muted">{[version, sizeText, L.meta].filter(Boolean).join(", ")}</p>
    <p class="small muted">{L.autoGame}</p>
    <div class="pic fog crt shota" role="img" aria-label={L.heroAlt} style={art("a-big.webp")}></div>
  </section>

  <div class="route-gap" aria-hidden="true"><svg viewBox="0 0 900 100" preserveAspectRatio="none"><path class="route" d={routeD[0]} /></svg></div>

  <section class="sec content" data-stop="1" aria-labelledby="campaign-title">
    <div class="hd">
      <h2 id="campaign-title">{L.campaignTitle}</h2>
      <svg class="squig" viewBox="0 0 300 12" aria-hidden="true"><path d="M2 7 C40 2, 74 11, 112 6 S 180 2, 224 7 S 272 3, 298 6" fill="none" stroke="#f0c96a" stroke-width="2.5" /></svg>
    </div>
    <p>{L.campaignText}</p>
    <div class="shots">
      <div class="pic crt fog" role="img" aria-label={L.townAlt} style={art("b-town.webp")}></div>
      <div class="pic crt fog" role="img" aria-label={L.battleAlt} style={art("b-battle.webp")}></div>
      <div class="pic crt fog" role="img" aria-label={L.battleAlt2} style={art("b-battle-alt.webp")}></div>
    </div>
    <div class="linkrow"><a class="link" href={href(lang, "features/")}>{L.campaignLink}</a></div>
  </section>

  <div class="route-gap" aria-hidden="true"><svg viewBox="0 0 900 100" preserveAspectRatio="none"><path class="route" d={routeD[1]} /></svg></div>

  <section class="sec content" data-stop="2" aria-labelledby="devices-title">
    <div class="hd">
      <h2 id="devices-title">{L.devicesTitle}</h2>
      <svg class="squig" viewBox="0 0 300 12" aria-hidden="true"><path d="M2 6 C50 11, 90 2, 140 7 S 220 11, 268 5 S 290 8, 298 6" fill="none" stroke="#f0c96a" stroke-width="2.5" /></svg>
    </div>
    <p>{L.devicesText}</p>
    <div class="row" style="align-items:flex-end">
      <div class="pic crt fog" role="img" aria-label={L.pcAlt} style={`width:min(480px, 100%); aspect-ratio:16/10; ${art("shot-game.webp")}`}></div>
      <div class="pic crt fog" role="img" aria-label={L.phoneAlt} style={`width:150px; aspect-ratio:1/2; ${art("shot-devices.webp")}`}></div>
    </div>
  </section>

  <div class="route-gap" aria-hidden="true"><svg viewBox="0 0 900 100" preserveAspectRatio="none"><path class="route" d={routeD[2]} /></svg></div>

  <section class="sec content" data-stop="3" aria-labelledby="hub-title">
    <div class="hd">
      <h2 id="hub-title">{L.hubTitle}</h2>
      <svg class="squig" viewBox="0 0 300 12" aria-hidden="true"><path d="M2 6 C50 11, 90 2, 140 7 S 220 11, 268 5 S 290 8, 298 6" fill="none" stroke="#f0c96a" stroke-width="2.5" /></svg>
    </div>
    <p>{L.hubText}</p>
    <div class="hubmap">
      <div class="pic crt fog" role="img" aria-label={L.hubAlt} style={art("d-hub.webp")}></div>
      <span class="banner" style="left:6%; top:14%">Эволюция</span>
      <span class="pin" style="left:8%; top:40%"></span>
      <span class="banner" style="left:44%; top:52%">Проклятое озеро</span>
      <span class="pin" style="left:46%; top:76%"></span>
      <span class="banner" style="left:62%; top:10%">Новогодний мод</span>
      <span class="pin" style="left:64%; top:36%"></span>
    </div>
    <div class="hub-list">
      <article class="panel"><div class="titlebar">Эволюция</div><p class="small">{L.hubKindMod}, {L.hubAuthor}: …</p></article>
      <article class="panel"><div class="titlebar">Проклятое озеро</div><p class="small">{L.hubKindMap}, {L.hubAuthor}: …</p></article>
      <article class="panel"><div class="titlebar">Новогодний мод</div><p class="small">{L.hubKindMod}, {L.hubAuthor}: …</p></article>
    </div>
    <!-- TODO(hub cards): the hub cards come from the razdor-community catalog; these are placeholders. -->
    <div class="linkrow"><a class="link" href={href(lang, "community/")}>{L.hubAll}</a></div>
  </section>

  <div class="route-gap" aria-hidden="true"><svg viewBox="0 0 900 100" preserveAspectRatio="none"><path class="route" d={routeD[3]} /></svg></div>

  <Battle lang={lang} />

  <section class="sec content" id="path" data-stop="5" aria-labelledby="path-title">
    <div class="hd">
      <h2 id="path-title">{L.pathTitle}</h2>
      <svg class="squig" viewBox="0 0 300 12" aria-hidden="true"><path d="M2 8 C60 3, 100 10, 150 6 S 240 2, 298 7" fill="none" stroke="#f0c96a" stroke-width="2.5" /></svg>
    </div>
    <p>{L.pathText}</p>
    <div class="steps">
      <article class="panel"><div class="titlebar">1</div><span class="step-digit">1</span><p>{L.step1}</p></article>
      <article class="panel"><div class="titlebar">2</div><span class="step-digit">2</span><p>{L.step2}</p></article>
      <article class="panel"><div class="titlebar">3</div><span class="step-digit">3</span><p>{L.step3}</p></article>
    </div>
    <div class="row"><a class="btn" href={href(lang, "download/")} data-dl>{S.common.download}</a></div>
    <div class="linkrow"><a class="link" href={href(lang, "download/") + "#install"}>{S.common.detailedInstall}</a></div>
  </section>

  <div class="sec-wide content two-col">
    <section aria-labelledby="community-title">
      <h2 id="community-title">{L.communityTitle}</h2>
      <p>{hub}</p>
      <a class="btn sm" href="https://discord.gg/wmMksmWFDM">{S.common.discord}</a>
    </section>
    <section aria-labelledby="news-title">
      <h2 id="news-title">{L.newsTitle} {version}</h2>
      <p class="news-date">{dateText}</p>
      {news.length > 0 && (
        <ul class="news-list">
          {news.map((line) => <li>{line}</li>)}
        </ul>
      )}
      <a class="link" href={href(lang, "changes/")}>{L.allChanges}</a>
    </section>
  </div>

  <section class="sec-wide content" id="trailer" aria-labelledby="thorny-title">
    <div class="two-col" style="align-items:center">
      <div class="pic" role="img" aria-label={L.thornyAlt} style={`width:min(462px,100%); aspect-ratio:462/174; ${art("thorny-capsule.webp")}`}></div>
      <div>
        <h3 id="thorny-title">{L.thornyTitle}</h3>
        <p>{L.thornyText}</p>
        <a class="btn ghost sm" href="https://store.steampowered.com/app/2182610/" target="_blank" rel="noopener">{L.steam}</a>
      </div>
    </div>
  </section>
</div>


